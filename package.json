{
  "name": "ryanbibi-digital-garden",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run food:validate && npm run food:summary && npm run activity:generate && vite build && node scripts/prune-build-assets.mjs",
    "activity:generate": "node scripts/generate-activity-feed.mjs",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "food:import": "node scripts/import-food-data.mjs",
    "food:migrate": "node scripts/migrate-food-data.mjs",
    "food:summary": "node scripts/generate-food-summary.mjs",
    "food:validate": "node scripts/validate-food-data.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "read-excel-file": "^5.8.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
